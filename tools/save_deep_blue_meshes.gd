extends SceneTree
func _initialize():call_deferred("run")
func as_vector(values: Array) -> Vector3:return Vector3(values[0],values[1],values[2])
func run():
 var data=JSON.parse_string(FileAccess.get_file_as_string("/tmp/deep-blue-live.json"));assert(data is Dictionary)
 DirAccess.make_dir_recursive_absolute("res://assets/models/reference/live")
 var script="extends RefCounted\n## Generated by bake_deep_blue.gd / prepare_deep_blue_live.py / save_deep_blue_meshes.gd.\n"
 for name in data.parts:
  var part=data.parts[name];var arrays=[];arrays.resize(Mesh.ARRAY_MAX)
  var vertices=PackedVector3Array();var normals=PackedVector3Array();var uv=PackedVector2Array();var indices=PackedInt32Array()
  for row in part.vertices:vertices.append(as_vector(row))
  for row in part.normals:normals.append(as_vector(row))
  for row in part.uv:uv.append(Vector2(row[0],row[1]))
  for index in part.indices:indices.append(int(index))
  arrays[Mesh.ARRAY_VERTEX]=vertices;arrays[Mesh.ARRAY_NORMAL]=normals;arrays[Mesh.ARRAY_TEX_UV]=uv;arrays[Mesh.ARRAY_INDEX]=indices
  var raw=ArrayMesh.new();raw.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,arrays)
  var tool=SurfaceTool.new();tool.create_from(raw,0);tool.generate_tangents();var mesh=tool.commit()
  var path="res://assets/models/reference/live/"+name+".res";assert(ResourceSaver.save(mesh,path,ResourceSaver.FLAG_COMPRESS)==OK)
  script+='const '+str(name).to_upper()+'=preload("'+path+'")\n'
 for name in data.metadata:
  var value=data.metadata[name];var key=str(name).to_upper()
  if name=="guides":
   script+='const GUIDES=[\n'
   for point in value:script+=' Vector3(%.10f,%.10f,%.10f),\n'%point
   script+=']\n'
  elif value is Array:script+='const '+key+'=Vector3(%.10f,%.10f,%.10f)\n'%value
  else:script+='const '+key+'=%.10f\n'%value
 var output=FileAccess.open("res://scripts/deep_blue_data.gd",FileAccess.WRITE);output.store_string(script);output.close()
 print("Saved six compact static meshes and measured live-pivot/guide metadata");quit()
